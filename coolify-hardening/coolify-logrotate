# Logrotate para Docker containers (Coolify + Traefik + DB + Redis)
# Instale: sudo cp coolify-logrotate /etc/logrotate.d/coolify

/var/lib/docker/containers/*/*.log {
    daily
    rotate 7
    compress
    delaycompress
    missingok
    notifempty
    create 0644 root root
    sharedscripts
    postrotate
        # Sinaliza Docker para reabrir file handles
        # systemctl reload docker > /dev/null 2>&1 || true
        # Melhor: usar docker kill --signal=USR1 <container> mas precisa saber IDs
        # Docker 20.10+ reabre automaticamente após rotate se usar 'copytruncate'
    endscript
}

